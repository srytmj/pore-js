{
  "name": "porejs",
  "version": "1.0.0-rc.1",
  "description": "Framework-agnostic web reader engine for manga, comics and books (EPUB, PDF, CBZ): sources, image engine, text engine, position model",
  "license": "MIT",
  "author": "Surya",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "reader",
    "epub",
    "pdf",
    "cbz",
    "manga",
    "comic",
    "webtoon",
    "pagination",
    "epubcfi",
    "ereader"
  ],
  "homepage": "https://github.com/srytmj/pore-js#readme",
  "bugs": "https://github.com/srytmj/pore-js/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srytmj/pore-js.git",
    "directory": "packages/reader-core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "pdfjs-dist": "^6.2.108"
  }
}
