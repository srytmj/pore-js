{
  "name": "@pore/reader-react",
  "version": "0.0.0",
  "description": "React 19 bindings for @pore/reader-core",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
