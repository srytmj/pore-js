{
  "name": "pore-js",
  "version": "0.0.0",
  "private": true,
  "description": "Pore.js — source-agnostic web reader engine for manga and text",
  "license": "MIT",
  "author": "Surya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srytmj/pore-js.git"
  },
  "homepage": "https://github.com/srytmj/pore-js#readme",
  "bugs": "https://github.com/srytmj/pore-js/issues",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm --filter @pore/demo dev",
    "gen:fixtures": "node scripts/gen-fixtures.mjs",
    "typecheck": "tsc -b --force && pnpm --filter @pore/example-host-app typecheck",
    "example": "pnpm --filter @pore/example-host-app dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "corpus:fetch": "node scripts/fetch-corpus.mjs",
    "test:corpus": "vitest run --project=corpus",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "verify:packages": "node scripts/verify-packages.mjs",
    "release": "pnpm build && node scripts/verify-packages.mjs && changeset publish",
    "clean": "pnpm -r exec rimraf dist .turbo node_modules/.cache && rimraf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.2",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
